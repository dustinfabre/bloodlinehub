APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Must be false in production: debug pages show code, settings and queries
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Load balancer / CDN addresses to trust for the visitor's IP (comma-separated, or * if the app is only reachable through it)
TRUSTED_PROXIES=

# Public marketplace; while false, /marketplace shows a "coming soon" page
FEATURE_MARKETPLACE=false

# Photos are saved to each user's own Google Drive (Settings → Storage). Create an OAuth client of type "Web application"
# in Google Cloud Console, enable the Google Drive API, and add {APP_URL}/settings/storage/google/callback as an
# authorized redirect URI. Only the drive.file scope is requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only needed when the callback URL differs from {APP_URL}/settings/storage/google/callback
GOOGLE_REDIRECT_URI=

# Payment receipts, bank QR codes and feedback screenshots go to a PRIVATE Cloudflare R2 bucket (never public; the app
# streams each file only to who may see it). Create an R2 API token with Object Read & Write on that bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://{account id}.r2.cloudflarestorage.com
R2_ENDPOINT=
# Set to "local" to keep these files in storage/app/private instead (local development without R2)
PRIVATE_FILES_DISK=r2
